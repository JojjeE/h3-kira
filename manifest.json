				{
					"id": "sha-peacock",
					"name": "Peacock Addon",
					"description": "Install the suit to your game as an addon without replacing existing suits. This will only work if you're playing with Peacock, or offline.",
					"image": "blobs/sheerheartattack/addon/images/unlockables_override/47_Outfits_sheer_heart_attack.jpg",
					"data": {
						"contentFolders": ["replace/sheerheartattack/addon", "base/sheerheartattack"],
						"blobFolders": ["blobs/sheerheartattack/addon"],
						"localisation": {
							"UI_TOKEN_OUTFIT_HERO_SHEER_HEART_ATTACK_NAME": {
								"english": "Sheer Heart Attack",
								"french": "Sheer Heart Attack",
								"italian": "Sheer Heart Attack",
								"german": "Sheer Heart Attack",
								"spanish": "Sheer Heart Attack",
								"russian": "Sheer Heart Attack",
								"japanese": "Sheer Heart Attack"
							},
							"UI_TOKEN_OUTFIT_HERO_SHEER_HEART_ATTACK_DESC": {
								"english": "A crisp white suit with a wine striped shirt. What could be better? Top it off with an iconic tie and you're set to take on a crazy, noisy, bizarre town.",
								"french": "Un costume blanc impeccable avec une chemise à rayures bordeaux. Quoi de mieux ? Ajoutez-y une cravate emblématique et vous êtes prêt à affronter une ville folle, bruyante et bizarre.",
								"italian": "Un elegante abito bianco con una camicia a righe color vino. Cosa c'è di meglio? Completa il look con una cravatta iconica e sarai pronto per affrontare una città folle, rumorosa e bizzarra.",
								"german": "Ein knackig weißer Anzug mit einem weinroten gestreiften Hemd. Was könnte besser sein? Mit einer kultigen Krawatte als Krönung bist du bereit, dich in eine verrückte, laute, bizarre Stadt zu stürzen.",
								"spanish": "Un traje blanco impecable con una camisa a rayas color vino. ¿Qué podría ser mejor? Complétalo con una corbata icónica y estarás listo para enfrentarte a una ciudad loca, ruidosa y extraña.",
								"russian": "Белоснежный костюм с рубашкой в винные полоски. Что может быть лучше? Добавьте к этому культовый галстук, и вы готовы покорить этот сумасшедший, шумный и причудливый город.",
								"japanese": "真っ白なスーツにワイン色のストライプシャツ。これ以上ない組み合わせだ。そこに象徴的なネクタイを合わせれば、狂騒と騒音と奇妙な町に立ち向かう準備は万端だ。"
							}
						},
						"localisedLines": {
							"[assembly:/localization/hitman6/conversations/ui/pro/online/repository/outfits_hero_s3.sweetmenutext?/char_global_hero_sheer_heart_attack_m_name_66314638-5be7-44f8-bae1-4e715696beba.sweetline].pc_sweetline": "UI_TOKEN_OUTFIT_HERO_SHEER_HEART_ATTACK_NAME",
							"[assembly:/localization/hitman6/conversations/ui/pro/online/repository/outfits_hero_s3.sweetmenutext?/char_global_hero_sheer_heart_attack_m_desc_66314638-5be7-44f8-bae1-4e715696beba.sweetline].pc_sweetline": "UI_TOKEN_OUTFIT_HERO_SHEER_HEART_ATTACK_DESC"
						}
					}
