				{
					"id": "kq-peacock",
					"name": "Peacock Addon",
					"description": "Install the suit to your game as an addon without replacing existing suits. This will only work if you're playing with Peacock, or offline.",
					"image": "blobs/killerqueen/addon/images/unlockables_override/47_Outfits_killer_queen.jpg",
					"data": {
						"contentFolders": ["replace/killerqueen/addon", "base/killerqueen"],
						"blobFolders": ["blobs/killerqueen/addon"],
						"localisation": {
							"UI_TOKEN_OUTFIT_HERO_KILLER_QUEEN_NAME": {
								"english": "Killer Queen",
								"french": "Killer Queen",
								"italian": "Killer Queen",
								"german": "Killer Queen",
								"spanish": "Killer Queen",
								"russian": "Killer Queen",
								"japanese": "Killer Queen"
							},
							"UI_TOKEN_OUTFIT_HERO_KILLER_QUEEN_DESC": {
								"english": "With a lovely lavender Valentino suit and cyan striped shirt, this outfit is perfect for the salaryman who just wants to live a peaceful life. Note: No local artisanal sandwich, or severed hands included.",
								"french": "Avec son élégant costume Valentino couleur lavande et sa chemise à rayures cyan, cette tenue est parfaite pour le salaryman qui souhaite simplement mener une vie paisible. Remarque : aucun sandwich artisanal local ni aucune main coupée ne sont inclus.",
								"italian": "Con un delizioso completo Valentino color lavanda e una camicia a righe ciano, questo outfit è perfetto per l'impiegato che desidera solo vivere una vita tranquilla. Nota: non sono inclusi né panini artigianali locali né mani mozzate.",
								"german": "Mit einem hübschen lavendelfarbenen Valentino-Anzug und einem cyanfarbenen gestreiften Hemd ist dieses Outfit perfekt für den Angestellten, der einfach nur ein ruhiges Leben führen möchte. Hinweis: Lokale handwerklich hergestellte Sandwiches oder abgetrennte Hände sind nicht enthalten.",
								"spanish": "Con un precioso traje lavanda de Valentino y una camisa a rayas cian, este conjunto es perfecto para el oficinista que solo quiere llevar una vida tranquila. Nota: No se incluyen sándwiches artesanales locales ni manos cortadas.",
								"russian": "Этот наряд, состоящий из прекрасного лавандового костюма Валентино и рубашки в голубые полоски, идеально подходит для офисного работника, который просто хочет жить спокойной жизнью. Примечание: местные ремесленные сэндвичи и отрезанные руки в комплект не входят.",
								"japanese": "素敵なラベンダー色のヴァレンティノのスーツにシアンのストライプシャツ。平穏な生活を送りたいサラリーマンにぴったりの装いです。※地元の職人手作りサンドイッチや切断された手は付属しません。"
							}
						},
						"localisedLines": {
							"[assembly:/localization/hitman6/conversations/ui/pro/online/repository/outfits_hero_s3.sweetmenutext?/char_global_hero_killer_queen_m_name_68e26e5e-9f3e-4fd2-9864-3443fbd12610.sweetline].pc_sweetline": "UI_TOKEN_OUTFIT_HERO_KILLER_QUEEN_NAME",
							"[assembly:/localization/hitman6/conversations/ui/pro/online/repository/outfits_hero_s3.sweetmenutext?/char_global_hero_killer_queen_m_desc_68e26e5e-9f3e-4fd2-9864-3443fbd12610.sweetline].pc_sweetline": "UI_TOKEN_OUTFIT_HERO_KILLER_QUEEN_DESC"
						}
					}
